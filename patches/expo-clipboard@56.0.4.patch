   private val ClipboardManager.firstItem: ClipData.Item?
     get() = primaryClip?.takeIf { it.itemCount > 0 }?.getItemAt(0)
 
+  /**
+   * Finds the first readable image URI across all clip items. Cross-device
+   * clipboard syncs (e.g. Google Clipboard) can emit a multi-item clip whose
+   * first item is a text label (often a source-device `file://` path) with the
+   * actual image in a later item, or packed inside an Intent with EXTRA_STREAM.
+   * The clip description has already been verified to advertise an image MIME.
+   */
+  private fun firstImageUri(clip: ClipData): Uri? {
+    val uris = ArrayList<Uri>()
+    for (index in 0 until clip.itemCount) {
+      collectItemUris(clip.getItemAt(index), uris)
+    }
+    return uris.firstOrNull { uri -> isReadableImageUri(uri) }
+      ?: uris.firstOrNull()
+  }
+
+  private fun collectItemUris(item: ClipData.Item, output: MutableList<Uri>) {
+    item.uri?.let { output.add(it) }
+    item.intent?.let { intent ->
+      intent.clipData?.let { nested ->
+        for (index in 0 until nested.itemCount) {
+          nested.getItemAt(index).uri?.let { output.add(it) }
+        }
+      }
+      @Suppress("DEPRECATION")
+      intent.getParcelableExtra<Uri>(Intent.EXTRA_STREAM)?.let { output.add(it) }
+    }
+  }
+
+  private fun isReadableImageUri(uri: Uri): Boolean = runCatching {
+    context.contentResolver.getType(uri)?.startsWith("image/") == true
+  }.getOrDefault(false)
+
   // endregion
 }
 
