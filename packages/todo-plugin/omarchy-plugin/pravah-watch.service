[Unit]
Description=Pravah watch — Convex websocket snapshot for the Omarchy bar widget
Documentation=https://github.com/Snehit70/pravah
# The widget needs a published snapshot to render. Starting it after the network
# is up means the first connect attempt has a route to Convex.
After=network-online.target
Wants=network-online.target
# A dropped socket is normal on a long-lived connection. Without this, systemd
# rate-limits restarts and can leave the widget without a snapshot.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/pravah watch
Restart=always
RestartSec=5

# Create the snapshot directory before mount sandboxing, including on login.
RuntimeDirectory=pravah
RuntimeDirectoryMode=0700
# Keep the last snapshot visible while the socket reconnects after a restart.
RuntimeDirectoryPreserve=restart

# `pravah watch` holds one Convex socket and writes a snapshot file. It needs no
# privileges, so keep the sandbox tight.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t/pravah

[Install]
WantedBy=default.target
